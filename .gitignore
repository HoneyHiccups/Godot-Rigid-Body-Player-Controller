*.pdb
*.res
*.exp
*.dll
*.lib
Debug/
Release/
x64/
*.vspscc
*.vssscc
*.user
*.cache/
.vs/

# Visual Studio Code CodeSpaces
.code-workspace

# CMake
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
Makefile
CTestTestfile.cmake
*.cmake

# Code::Blocks
*.depend
*.layout
*.cbp
*.workspace

# Eclipse CDT
.project
.cproject
.settings/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Qt Creator
*.pro.user*
*.qbs.user*
*.pro.user
*.qmake.stash
*.autosave


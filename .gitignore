# Godot auto generated files
*.gen.*
.godot/

# Ignore the top-level bin folder
/bin/

# Ignore all bin folders inside test_project
/test_project/**/bin/

# Ignore custom.py
custom.py

# Ignore generated compile_commands.json
compile_commands.json

# Ignore files generated for documentation
/gen/

# Ignore inner license files (could be added when testing full_plugin_compilation zip)
test_project/**/LICENSE*

# Binaries
*.o
*.os
*.so
*.obj
*.bc
*.pyc
*.dblite
*.pdb
*.lib
*.config
*.creator
*.creator.user
*.files
*.includes
*.idb
*.exp

# Additional binaries
*.a              # Static libraries (Linux/macOS)
*.la             # libtool archives
*.lo             # libtool objects
*.dll            # Windows dynamic libraries
*.dylib          # macOS dynamic libraries
*.exe            # Windows executables
*.out            # Common output file
*.app            # macOS applications
*.bin            # Raw binaries
*.elf            # Executable and Linkable Format
*.hex            # Intel HEX files (embedded)
*.map            # Linker map files
*.wasm           # WebAssembly modules
*.mod            # Fortran/C++ modules
*.sav            # Saved states (e.g., from emulators or tools)
*.d              # Dependency files (e.g., from `-MD` in GCC)

# Other stuff
*.log

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# macOS Finder
.DS_Store

# JetBrains CLion / IntelliJ / Rider
.idea/
*.iml
*.ipr
*.iws
cmake-build-*/

# KDevelop
.kdev4/
.kdevduchain/
.kdev_include_paths
.kdevses

# Sublime Text
*.sublime-workspace
*.sublime-project

# Visual Studio (Community/Pro/Enterprise)
*.sln
*.suo

[sub_resource type="GDScript" id="GDScript_oo8lq"]
resource_name = "Ai Possed.gd"
script/source = "extends Node3D

@onready var shaker_wrapper: Node3D = $HeadPiv/ShakerWrapper

@onready var Player : RigidPlayer = $\"..\"
@export var DebugDraw:bool = true
@onready var landvol : float =0;
var wait:float = 10.0;
var collecttime:float = 0;
var dirstate:float = 1;
func _ready() -> void: 
	Player.set_allow_align_with_gravity(true);
	Player.enable_ai_posses(true);
	return;

func _physics_process(delta: float) -> void:
	collecttime = collecttime+delta;
	if collecttime >= wait:
		collecttime = 0;
		set_input(Vector2(dirstate,0))
		if(dirstate ==1):
			dirstate = -1;
		else:
			dirstate = 1;
	return;
	
func set_input(dir:Vector2)-> void:
	print(dir)
	Player.virtual_inputdir(dir)
	Player.virtual_jump()
"


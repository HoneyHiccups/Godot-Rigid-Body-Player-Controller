[sub_resource type="GDScript" id="GDScript_8b233"]
resource_name = "solve_for_gravity"
script/source = "extends Area3D
@onready var target_node :Node3D = $Target
@onready var ring_root : Node3D = $\"../..\"



func _ready() -> void:
	solve_gravity()

func solve_gravity() -> void:
	var new_grav_dir : Vector3 = target_node.global_position - self.global_position
	self.gravity_direction = new_grav_dir.normalized()


func change_gravity_power() -> void:
	pass
"


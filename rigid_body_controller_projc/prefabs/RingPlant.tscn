[sub_resource type="GDScript" id="GDScript_manrx"]
resource_name = "SideGravityWells"
script/source = "extends Area3D
@onready var target_node :Node3D = $Target

func _ready() -> void:
	solve_gravity()

func solve_gravity() -> void:
	var new_grav_dir : Vector3 =  self.global_position - target_node.global_position
	self.gravity_direction = new_grav_dir.normalized()


func change_gravity_power() -> void:
	pass



func _on_body_shape_entered(body_rid: RID, body: Node3D, body_shape_index: int, local_shape_index: int) -> void:
	if(body is RigidPlayer):
		var player : RigidPlayer = body
		player.set_allow_align_with_gravity(false)



func _on_body_shape_exited(body_rid: RID, body: Node3D, body_shape_index: int, local_shape_index: int) -> void:
	if(body is RigidPlayer):
		var player : RigidPlayer = body
		player.set_allow_align_with_gravity(true)
"


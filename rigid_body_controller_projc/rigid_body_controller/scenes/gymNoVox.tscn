[sub_resource type="PhysicsMaterial" id="PhysicsMaterial_54tkj"]
bounce = 0.14

[sub_resource type="GDScript" id="GDScript_54tkj"]
resource_name = "ShiftGravity"
script/source = "extends Area3D


@onready var ancorpoint: Node3D = $\"../..\"
@onready var this : Area3D = self;

func _physics_process(delta: float) -> void:
	var newgravitydir : Vector3 = this.global_position - ancorpoint.global_position;
	newgravitydir = newgravitydir.normalized();
	this.gravity_direction = newgravitydir;
	return;
"


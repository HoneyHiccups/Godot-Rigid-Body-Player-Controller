[sub_resource type="GDScript" id="GDScript_2tlil"]
resource_name = "gameinsta"
script/source = "extends Node3D

@onready var rigid_player_pawn: RigidPlayer = $PlayerPawns/RigidPlayerPawn



func _physics_process(delta: float) -> void:
	if(Input.get_action_strength(\"SensUp\") == 1):
		rigid_player_pawn.sensitivity = rigid_player_pawn.sensitivity+delta
	if(Input.get_action_strength(\"SensDown\") == 1):
		rigid_player_pawn.sensitivity = clampf(rigid_player_pawn.sensitivity-delta,delta,12.0) 
	if(Input.is_action_just_pressed(\"Reset\") == true):
		get_tree().change_scene_to_file(\"res://rigid_body_controller/scenes/gymNoVox.tscn\")
		print(\"sence change\")
"

